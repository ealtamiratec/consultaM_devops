                      {
                        "active_deadline_seconds": 0,
                        "affinity": [],
                        "automount_service_account_token": true,
                        "container": [
                          {
                            "args": [
                              "set -e\necho \"Esperando MySQL en ${DB_HOST}:3306...\"\nuntil mysql -h\"${DB_HOST}\" -u\"${DB_USER}\" -p\"${DB_PASSWORD}\" -Nse \"SELECT 1\" \u003e/dev/null 2\u003e\u00261; do\n  sleep 3\ndone\n\nTABLE_EXISTS=$(mysql -h\"${DB_HOST}\" -u\"${DB_USER}\" -p\"${DB_PASSWORD}\" -Nse \"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}' AND table_name='usuarios';\")\n\nif [ \"${TABLE_EXISTS}\" = \"0\" ]; then\n  echo \"Schema no encontrado. Importando /seed/database.sql...\"\n  mysql -h\"${DB_HOST}\" -u\"${DB_USER}\" -p\"${DB_PASSWORD}\" \"${DB_NAME}\" \u003c /seed/database.sql\n  echo \"Inicialización completada\"\nelse\n  echo \"Schema ya inicializado. No se requiere import\"\nfi\n"
                            ],
                            "command": [
                              "/bin/sh",
                              "-c"
                            ],
                            "env": [
                              {
                                "name": "DB_HOST",
                                "value": "mysql",
                                "value_from": []
                              },
                              {
                                "name": "DB_NAME",
                                "value": "consulta_medica",
                                "value_from": []
                              },
                              {
                                "name": "DB_USER",
                                "value": "consulta_app",
                                "value_from": []
                              },
                              {
                                "name": "DB_PASSWORD",
                                "value": "",

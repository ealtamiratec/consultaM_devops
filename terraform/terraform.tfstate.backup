      "name": "mysql_seed",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "consulta-medica/mysql-seed",
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
